# =============================================================
# G2G AI Pool — Environment Variables
# Copy to .env and fill in your real values
# =============================================================

# Airtable
AIRTABLE_TOKEN=patXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE=appRQwVddDxQdU6P3

# AI Provider Keys (add as many as you have, name them KEY_1, KEY_2, ...)
ANTHROPIC_KEY_1=sk-ant-XXXXXXXXXXXXXXXX
OPENAI_KEY_1=sk-XXXXXXXXXXXXXXXX
GEMINI_KEY_1=AIzaXXXXXXXXXXXXXXXX
PERPLEXITY_KEY_1=pplx-XXXXXXXXXXXXXXXX

# Optional: alerts webhook (LINE Notify or your own)
CEO_ALERT_WEBHOOK=

# Server
PORT=8080
USD_TO_THB=36.0
MARKUP_BASE=3.5
MARKUP_FLOOR=3.0
MARKUP_BLENDED_TARGET=4.0
GOV_SLA_PREMIUM=0.10
ARBITRAGE_ENABLED=true
QUOTA_DEGRADE_THRESHOLD=0.85
